DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=benlai_gaoding
DB_USER=root
DB_PASS=
# 必填：JWT 签名密钥。生产环境务必使用足够长的随机字符串（32 字节以上），切勿使用示例值。
# 生成示例： node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# 允许跨域访问后端的前端来源，多个用逗号分隔。生产环境请设置为正式域名。
ALLOWED_ORIGINS=http://localhost:3089,http://127.0.0.1:3089
# All uploaded originals, thumbnails, parsed layers, exports, and fonts are stored under this server-side path.
# Use an absolute path like D:\benlai-uploads when you want to place files outside the project.
UPLOAD_DIR=./uploads
# Optional. Path to AlibabaPuHuiTi-3-55-Regular.ttf used as the default edit/export CJK font.
# If empty, the server tries UPLOAD_DIR/fonts/AlibabaPuHuiTi-3-55-Regular.ttf and local dev fallback paths.
DEFAULT_CN_EDIT_FONT_PATH=
# Optional press-provided CMYK output ICC profile. If empty, the server uses
# the generic perceptual CMYK profile and never guesses from OS profiles.
CMYK_ICC_PROFILE_PATH=
PORT=3088
# 默认 4MB，给 multipart 头部留余量，避免 5MB 网关/SDP 限制拦截分片上传。
TRANSFER_CHUNK_SIZE=4194304
# 老 CPU 服务器如果 pdfium-native 启动时报 CPU feature warning，可设为 1 跳过 PDFium，改用 pdfjs/Inkscape/sharp fallback。
DISABLE_PDFIUM_NATIVE=0
# 部署救急开关：设为 1 后，服务启动时不自动重扫 pending/parsing 的 PSD/AI/PDF 解析任务。
DISABLE_BOOTSTRAP_PARSE=0
# PSD/AI/PDF 解析并发数。解析任务很吃内存，2G 内存服务器建议保持 1。
PARSE_MAX_CONCURRENT=1

AUTH_HUB_APP_ID=benlai-design
AUTH_HUB_APP_SECRET=
AUTH_HUB_DEFAULT_ROLE=user
AUTH_HUB_BASE_URL=
AUTH_HUB_LOGIN_URL=
# 生产回调需与 Auth Hub 应用白名单一致。
AUTH_HUB_CALLBACK_URL=
AUTH_HUB_EXCHANGE_URL=
BENLAI_SSO_API_ROOT=

# One-time administrator setup; remove the password after admin:create.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 启动时 + 登录时自动检查这里列出的员工工号，若已经存在数据库且不是 super_admin 就提升。
# 多个工号用逗号分隔；公开副本不预置员工身份。
# 留空表示不做自动提升；仍可用 `npm run grant:super-admin -- --employee-no=xxx` 手动赋权。
SUPER_ADMIN_EMPLOYEE_NOS=
# 兼容旧配置名；新部署建议使用 SUPER_ADMIN_EMPLOYEE_NOS。
SUPER_ADMIN_USERNAMES=
